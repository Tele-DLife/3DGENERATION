# --- Keep only the primary UI entry(s) under apps/ ---
# We run:
# - apps/app_demo_CHN.py (Chinese UI)
# - apps/app_demo_Eng.py (English UI)
# - apps/app_demo_pure.py (local/demo)
# Everything else named app_demo_*.py is treated as optional and ignored by default.
apps/app_demo_*.py
!apps/app_demo_CHN.py
!apps/app_demo_Eng.py
!apps/app_demo_pure.py

# Optional test helpers under apps/
apps/test_*.py

# Local scratch images accidentally added at repo root
3d.png
cousin.png

# Larger than 1MB
docs/assets/real2sim_mujoco.gif
docs/assets/scene3d.gif

# --- Local caches, checkpoints, and large assets (keep `git pull` / clones light) ---
# Only the repo-root `models/` tree (prefetch caches and model checkpoints).
# Do NOT use a bare `models/` pattern — it would ignore `embodied_gen/models/` (Python package).
/models/
/logs/

